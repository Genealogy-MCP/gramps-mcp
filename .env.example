# Gramps Web API Configuration (REQUIRED)
# Your Gramps Web instance URL (without /api suffix - will be added automatically)
GRAMPS_API_URL=https://your-gramps-web-domain.com
GRAMPS_USERNAME=your-username
GRAMPS_PASSWORD=your-password
GRAMPS_TREE_ID=your-tree-id  # Find this under System Information in Gramps Web

# HTTP bind address (OPTIONAL)
# The Docker image sets GRAMPS_MCP_HOST=0.0.0.0 so the published port reaches
# the server. Outside Docker the server defaults to 127.0.0.1 (loopback only);
# set 0.0.0.0 there only behind a firewall or reverse proxy.
# GRAMPS_MCP_HOST=0.0.0.0

# Extra Host headers /mcp accepts (OPTIONAL)
# /mcp answers HTTP 421 to any Host header that is not localhost. List the
# hosts a reverse proxy or another compose service uses, comma-separated.
# 'name:*' matches any port.
# GRAMPS_MCP_ALLOWED_HOSTS=gramps-mcp:8000,mcp.example.com

# Extra browser Origin headers /mcp accepts (OPTIONAL)
# /mcp answers HTTP 403 to a request whose Origin header is not localhost.
# Only browser clients send Origin; list the origins of the web pages that
# call /mcp, comma-separated, as scheme://host[:port] with no path.
# 'https://name:*' matches any port. Allowing a host above does not allow
# its origin.
# GRAMPS_MCP_ALLOWED_ORIGINS=https://mcp.example.com
